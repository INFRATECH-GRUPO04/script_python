# Configuração do gerador de dados simulados (gerar_dados_simulados.py).
# Copie para .env na raiz deste repositório antes de executar.

# MySQL de onde vêm os servidores ativos
DB_HOST=localhost
DB_DATABASE=infratech
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_PORT=3306

# S3 onde os CSVs do bronze são gravados
S3_BUCKET=nome-do-bucket
S3_BRONZE_PREFIX=01-bronze/

# ============================================================
# AWS / S3 - credenciais OPCIONAIS
# Na EC2 com IAM Role: deixe as credenciais comentadas; o boto3 usa a role.
# Fora da AWS: use UMA das duas formas abaixo.
# Nunca preencha só AWS_ACCESS_KEY_ID sem AWS_SECRET_ACCESS_KEY.
# ------------------------------------------------------------
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Forma 1: credenciais diretas (SESSION_TOKEN só se vier de STS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Forma 2: perfil compartilhado (~/.aws/credentials e ~/.aws/config)
# AWS_PROFILE=
# AWS_SHARED_CREDENTIALS_FILE=
# AWS_CONFIG_FILE=

# Simulação
FUSO=America/Sao_Paulo
DIAS_HISTORICO=30
PASSO_SEGUNDOS=60
SEED=20261125
DIAS_RECENTES=7
LACUNA_RECENTE_MINUTOS=180
LACUNA_ANTIGA_MIN_MINUTOS=30
LACUNA_ANTIGA_MAX_MINUTOS=120
SERVIDORES_OFFLINE_AGORA=2
OFFLINE_MINUTOS=50
