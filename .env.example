# Conexão com o MySQL (mesmos nomes usados pelo site)
DB_HOST=localhost
DB_DATABASE=infratech
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_PORT=3306

# S3 — na EC2 o boto3 usa a IAM Role; NÃO coloque ACCESS_KEY/SECRET aqui
S3_BUCKET=nome-do-seu-bucket
S3_BRONZE_PREFIX=01-bronze/
AWS_REGION=sa-east-1

# Simulação
FUSO=America/Sao_Paulo
DIAS_HISTORICO=30
PASSO_SEGUNDOS=60
SEED=20261125

# Lacunas: 3h/dia na última semana e 30-120min antes dela
DIAS_RECENTES=7
LACUNA_RECENTE_MINUTOS=180
LACUNA_ANTIGA_MIN_MINUTOS=30
LACUNA_ANTIGA_MAX_MINUTOS=120

# 2 servidores param 50min antes da execução (o gold considera offline após 40min)
SERVIDORES_OFFLINE_AGORA=2
OFFLINE_MINUTOS=50
